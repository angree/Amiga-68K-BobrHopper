config_description=Bobr Hopper - RTG (uaegfx / Picasso96) on a PLAIN 68020, no FPU
; Same machine as bh-aga.uae, with an RTG board added. The ONLY differences are
; the two gfxcard_* lines below: everything else must stay identical so that a
; visual difference between the two runs can only come from our display code
; taking the RTG path instead of the AGA c2p path.
;
; Read the header of bh-aga.uae for the rules that apply to both (use_gui=no,
; window position, JIT, runtime on the SSD, read-only hardfile).
cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=false
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=0.0
cachesize=8192
chipset=aga
chipset_compatible=A4000
chipmem_size=4
fastmem_size=0
z3mem_size=32
; --- The RTG board: this is what makes this config different ---
gfxcard_type=uaegfx
gfxcard_size=16
kickstart_rom_file=C:\temp\amiga_bobr\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:C:\temp\amiga_bobr\boot.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:C:\temp\amiga_bobr\work,-128
gfx_api=0
gfx_width_windowed=800
gfx_height_windowed=600
gfx_fullscreen_amiga=false
win32.posx=100
win32.posy=60
magic_mouse=true
magic_mousecursor=1
input.mouse_speed=100
use_gui=no
show_leds=true
sound_output=normal
sound_channels=stereo
sound_frequency=44100
sound_interpol=none
sound_filter=emulated
sound_stereo_separation=10
