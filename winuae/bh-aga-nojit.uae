config_description=Bobr Hopper - AGA, plain 68020, no FPU, JIT OFF (the honest timing machine)
; Identical to bh-aga.uae except cachesize=0. EVERY performance number that is
; meant to say something about real hardware must come from this config: with JIT
; on, the emulated CPU is far faster than any 68020 ever was, and a frame rate
; measured with it is meaningless (the OpenXcom port measured the distortion at
; roughly -70%..-80% when JIT was switched off).
cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=false
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=0.0
cachesize=0
chipset=aga
chipset_compatible=A4000
chipmem_size=4
fastmem_size=0
z3mem_size=32
kickstart_rom_file=C:\temp\amiga_bobr\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:C:\temp\amiga_bobr\boot.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:C:\temp\amiga_bobr\work,-128
gfx_api=0
gfx_width_windowed=800
gfx_height_windowed=600
gfx_fullscreen_amiga=false
win32.posx=100
win32.posy=60
magic_mouse=true
magic_mousecursor=1
input.mouse_speed=100
use_gui=no
show_leds=true
sound_output=normal
sound_channels=stereo
sound_frequency=44100
sound_interpol=none
sound_filter=emulated
sound_stereo_separation=10
